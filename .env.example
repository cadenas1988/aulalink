NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://aulalink:change-me@localhost:5432/aulalink
DATABASE_SSL=false

# Firma de tokens emitidos por el proveedor de identidad institucional.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=https://identity.example.edu/
JWT_AUDIENCE=aulalink-api

# HMAC distintos para llamadas NestJS→n8n y callbacks n8n→NestJS.
N8N_OUTBOUND_SECRET=replace-with-at-least-32-random-bytes
N8N_CALLBACK_SECRET=replace-with-at-least-32-random-bytes
N8N_WEBHOOK_URL=https://n8n.example.edu/webhook/pickup-events
WEBHOOK_MAX_AGE_SECONDS=300
OUTBOX_POLL_INTERVAL_MS=1000
ESCALATION_EMAIL_RECIPIENT=school-office@example.edu

# AES-256-GCM y HMAC-SHA256, ambos en base64, 32 bytes cada uno.
PHONE_ENCRYPTION_KEY=base64-encoded-32-byte-key
PHONE_LOOKUP_KEY=base64-encoded-32-byte-key

S3_REGION=us-east-1
S3_BUCKET=aulalink-private-photos
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
PHOTO_URL_TTL_SECONDS=300
CORS_ORIGINS=https://school.example.edu
